{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.js", "/*.css", "/*.json", "/*.ico", "/*.png", "/*.svg", "/*.woff2"]
  },
  "mimeTypes": {
    ".js": "application/javascript",
    ".mjs": "application/javascript",
    ".jsx": "application/javascript",
    ".css": "text/css",
    ".json": "application/json",
    ".woff2": "font/woff2"
  }
}
